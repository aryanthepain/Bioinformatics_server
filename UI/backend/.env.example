# Copy this file to ".env" in the same folder and fill in the values:
#     cp .env.example .env
# ".env" is ignored by git, so the secrets in it are never committed.
# (The tertiary level uses AlphaFold DB and Foldseek, which need no token.)

# Optional: use placeholder data for these levels even though a real module
# exists (comma-separated: primary, secondary, tertiary, quaternary).
# PFP_PLACEHOLDER_LEVELS=tertiary

# Optional: contact e-mail for the primary level's optional remote EMBL-EBI services
# (BLASTp and InterProScan). EBI requires one with every job; without it these two
# modules are skipped and the primary level runs the notebook's default fast local
# profile (DIAMOND, HMMER, ESM-2, ProtParam, UniProt).
# PFP_EBI_EMAIL=

# Optional: longest each EBI job may take, in seconds (defaults 1800 and 3600).
# PFP_EBI_BLAST_TIMEOUT=1800
# PFP_EBI_INTERPRO_TIMEOUT=3600

# Optional: set to off to ignore cached results of the real modules.
# PFP_CACHE=on

# Optional: longest the quaternary pipeline may take, in seconds (default 600).
# PFP_QUATERNARY_TIMEOUT=600

# Optional: seconds to wait for the quaternary level before the provisional
# prediction is shown (default 0 = as soon as the primary level is done).
# PFP_QUICK_RESULT_SECONDS=0

# Optional: load the ESM-2 and secondary-structure models when the server starts
# (the hosted Docker image does this; locally they load on first use).
# PFP_PRELOAD_MODELS=off
