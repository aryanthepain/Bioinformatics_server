# Settings for the hosted app. setup_server.sh creates deploy/.env from your
# answers; this file only shows what it contains. deploy/.env is never committed.

# The web address, without https:// (e.g. protfunc.duckdns.org).
SITE_ADDRESS=


# Contact e-mail for the primary level's optional EMBL-EBI services (BLASTp, InterProScan),
# which EBI requires. Leave empty for the notebook's default fast local profile
# (DIAMOND, HMMER, ESM-2, ProtParam, UniProt).
PFP_EBI_EMAIL=

# Load ESM-2 and the secondary-structure models when the server starts (keeps the free Oracle machine "busy").
PFP_PRELOAD_MODELS=on

# Optional: use placeholder data for a level whose web service is down, e.g.
# PFP_PLACEHOLDER_LEVELS=tertiary

# Optional: seconds to wait for the quaternary level before the provisional
# prediction is shown (default 0 = as soon as the primary level is done).
# PFP_QUICK_RESULT_SECONDS=0
